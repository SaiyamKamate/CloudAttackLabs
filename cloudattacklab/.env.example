# Copy to .env and change the values. .env is git-ignored; never commit it.
# docker compose reads .env automatically. When running the backend outside
# Docker, export the same variables in your shell.

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=cloudattacklab
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=cloudattacklab
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Optional: a full SQLAlchemy URL. If set, it replaces the five values above.
# DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/cloudattacklab

# --- Lab control ------------------------------------------------------------
# Shared secret between the platform and ShopCloud's /lab/* endpoints.
LAB_CONTROL_TOKEN=change-me-lab-token
# Where the backend reaches ShopCloud (the port published by the lab compose file).
SHOPCLOUD_URL=http://127.0.0.1:8081
# Only needed when running the backend outside Docker and these differ:
# LAB_COMPOSE_FILE=lab/docker-compose.lab.yml
# DOCKER_BIN=docker
# LAB_START_TIMEOUT_SECONDS=180

# --- Backend ----------------------------------------------------------------
BACKEND_PORT=8000
