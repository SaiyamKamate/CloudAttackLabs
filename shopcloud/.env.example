# Settings for the standalone ShopCloud (shopcloud/docker-compose.yml).
# Copy to .env in this folder (it is git-ignored) and set your own values.
# Generate each secret with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
# You paste both values into CloudAttackLab's Target Management when you
# register this ShopCloud. They are separate on purpose: the integration key only
# reads telemetry and proves identity; the control token changes the rate limit
# and resets the shop's data.

# X-Lab-Token for /lab/rate-limit and /lab/reset.
LAB_CONTROL_TOKEN=

# HMAC key for /integration/v1/* (at least 32 characters).
INTEGRATION_KEY=

# Stable name for this instance; CloudAttackLab checks it on every telemetry record.
INTEGRATION_INSTANCE_ID=shopcloud-standalone
