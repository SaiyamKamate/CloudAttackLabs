# scripts/setup.sh creates .env from this file with random passwords (never
# overwriting an .env you already have). Or copy it by hand, only if you have no
# .env yet:  [ -f .env ] || cp .env.example .env   and change the values.
# .env is git-ignored; never commit it. docker compose reads .env automatically. When
# running the backend outside Docker, export the same variables in your shell.
#
# Every default in this file, in docker-compose.yml and in the backend
# (lab-dev-token, change-me-lab-token, change-me-locally, ...) is published in
# this repository. They are for a local lab on 127.0.0.1 only. The backend logs
# a warning at startup while the default lab token or database password is in
# use. Set your own values before the database is first created.

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=cloudattacklab
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=cloudattacklab
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Optional: a full SQLAlchemy URL. If set, it replaces the five values above.
# DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/cloudattacklab

# --- Lab control ------------------------------------------------------------
# Shared secret between the platform and ShopCloud's /lab/* endpoints.
LAB_CONTROL_TOKEN=change-me-lab-token
# Where the backend reaches ShopCloud (the port published by the lab compose file).
SHOPCLOUD_URL=http://127.0.0.1:8081
# Only needed when running the backend outside Docker and these differ:
# LAB_COMPOSE_FILE=lab/docker-compose.lab.yml
# DOCKER_BIN=docker
# LAB_START_TIMEOUT_SECONDS=180

# --- Telemetry --------------------------------------------------------------
# Where the backend reads ShopCloud's logs: docker (the lab container's logs,
# works without the monitoring stack) or loki (needs the monitoring profile).
# With loki there is no fallback: if Loki cannot be read, the run fails.
TELEMETRY_SOURCE=docker
# Where the backend reaches Loki (the port published by the monitoring profile).
LOKI_URL=http://127.0.0.1:3100
# Optional: after a run, poll Loki every N seconds until the record count stops
# growing, for at most M seconds.
# LOKI_SETTLE_INTERVAL_SECONDS=2
# LOKI_SETTLE_TIMEOUT_SECONDS=20

# --- Falco ------------------------------------------------------------------
# Run Falco in the lab as extra evidence for the container scenario. Needs a
# privileged container and a kernel with BTF for the modern eBPF engine (see
# README). Off by default, so the platform runs where Falco cannot.
FALCO_ENABLED=false

# --- Monitoring (optional: Loki, Alloy, Grafana) ---------------------------
# Basic mode needs none of this. Start the monitoring stack with
#   docker compose --profile monitoring up -d     (or: scripts/start.sh --monitoring)
# Uncomment the next line to make every `docker compose` command include it:
# COMPOSE_PROFILES=monitoring
# Grafana's admin password. Required when the monitoring stack runs: Grafana
# exits at start with a clear error while it is empty.
GF_SECURITY_ADMIN_PASSWORD=change-me-grafana-password

# --- Backend ----------------------------------------------------------------
BACKEND_PORT=8000
